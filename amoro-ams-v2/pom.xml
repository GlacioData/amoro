<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.apache.amoro</groupId>
        <artifactId>amoro-parent</artifactId>
        <version>0.9-SNAPSHOT</version>
    </parent>

    <artifactId>amoro-ams-v2</artifactId>
    <name>Amoro AMS v2</name>
    <description>Spring Boot 3 based next-generation AMS host. Starts as the home of the Process
        control plane (spec/status + Transition state machine, see
        tasks/process-control-plane-spec.md) and absorbs AMS responsibilities module by
        module. Compiled with a Java 17 toolchain while the rest of the reactor stays on
        the Java 8 baseline.</description>

    <properties>
        <!-- Java 17 via toolchains; the reactor itself may keep running on JDK 8/11 -->
        <java.source.version>17</java.source.version>
        <java.target.version>17</java.target.version>
        <maven.compiler.release>17</maven.compiler.release>
        <spring-boot.version>3.5.16</spring-boot.version>
        <!-- jacoco 0.8.7 (repo-wide version) cannot instrument Java 17 class files -->
        <jacoco.skip>true</jacoco.skip>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-toolchains-plugin</artifactId>
                <version>3.2.0</version>
                <configuration>
                    <toolchains>
                        <jdk>
                            <version>[17,)</version>
                        </jdk>
                    </toolchains>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>toolchain</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          spring-boot-maven-plugin 3.x is Java 17 bytecode and must load inside Maven's
          own JVM, which the toolchain cannot provide. JDK 8/11 reactor builds therefore
          produce a plain jar; run Maven itself on JDK 17+ to get the executable boot
          jar. google-java-format 1.7 (repo-wide spotless) cannot run on JDK 17+, so
          the same profile skips formatting for this module only — formatting is still
          enforced by the JDK 8/11 reactor validate flow.
        -->
        <profile>
            <id>jdk17-boot-jar</id>
            <activation>
                <jdk>[17,)</jdk>
            </activation>
            <properties>
                <spotless.skip>true</spotless.skip>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-maven-plugin</artifactId>
                        <version>${spring-boot.version}</version>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>repackage</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>

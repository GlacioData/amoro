<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.apache.amoro</groupId>
        <artifactId>amoro-parent</artifactId>
        <version>0.9-SNAPSHOT</version>
    </parent>

    <artifactId>amoro-ams-v2</artifactId>
    <name>Amoro AMS v2</name>
    <description>Spring Boot 3 based next-generation AMS host with the generic resource framework
        and simulation-only Process control plane defined in tasks/amoro-ams-v2-process-spec.md.
        No Iceberg/Paimon Action or real Spark submission is included. Compiled with a Java 17
        toolchain while the rest of the reactor stays on the Java 8 baseline.</description>

    <properties>
        <!-- Java 17 via toolchains; the reactor itself may keep running on JDK 8/11 -->
        <java.source.version>17</java.source.version>
        <java.target.version>17</java.target.version>
        <maven.compiler.release>17</maven.compiler.release>
        <spring-boot.version>3.5.16</spring-boot.version>
        <testcontainers.version>1.21.4</testcontainers.version>
        <!-- jacoco 0.8.7 (repo-wide version) cannot instrument Java 17 class files -->
        <jacoco.skip>true</jacoco.skip>
        <!-- docker-mysql tests are excluded by default; -Pdocker-it clears this property -->
        <docker-mysql.excluded>docker-mysql</docker-mysql.excluded>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- Boilerplate elimination for the value-object-heavy control plane (version managed by
             the Boot BOM). The module-root lombok.config opts into fluent accessors to keep the
             existing name()/spec() accessor convention; the config and persistence/blob packages
             override back to JavaBeans naming for Spring binding and MyBatis row mapping. -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- YAML persistence format for format-strategized domains (framework spec §5.4);
             version managed by the Spring Boot BOM imported in this module only -->
        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-yaml</artifactId>
        </dependency>
        <!-- mybatis-spring-boot-starter is a third-party starter NOT managed by the Boot BOM:
             pinned explicitly in this module (dependency self-containment, framework spec §7) -->
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
            <version>3.0.4</version>
        </dependency>
        <!-- Boot BOM's default mysql-connector-j 9.x dropped MySQL 5.7 support: pin 8.x -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>8.4.0</version>
            <scope>runtime</scope>
        </dependency>
        <!-- Embedded local runtime and offline tests: Derby needs &gt;=10.15 on JDK 17; the shipped
             derby dialect SQL stays compatible with the repository's production 10.14.2.0. -->
        <dependency>
            <groupId>org.apache.derby</groupId>
            <artifactId>derby</artifactId>
            <version>10.16.1.1</version>
            <scope>runtime</scope>
        </dependency>
        <!-- 10.15+ jar split: the JDBC driver classes live in derbyshared -->
        <dependency>
            <groupId>org.apache.derby</groupId>
            <artifactId>derbyshared</artifactId>
            <version>10.16.1.1</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>mysql</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-toolchains-plugin</artifactId>
                <version>3.2.0</version>
                <configuration>
                    <toolchains>
                        <jdk>
                            <version>[17,)</version>
                        </jdk>
                    </toolchains>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>toolchain</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- keep constructor parameter names: Jackson creator binding relies on
                         them together with jackson-module-parameter-names -->
                    <parameters>true</parameters>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- property-driven group exclusion: -Pdocker-it clears the property so
                         the docker-mysql group runs; a literal excludedGroups here would be
                         impossible to override with -Dgroups (silent fake-green) -->
                    <excludedGroups>${docker-mysql.excluded}</excludedGroups>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          spring-boot-maven-plugin 3.x is Java 17 bytecode and must load inside Maven's
          own JVM, which the toolchain cannot provide. JDK 8/11 reactor builds therefore
          produce a plain jar; run Maven itself on JDK 17+ to get the executable boot
          jar. google-java-format 1.7 (repo-wide spotless) cannot run on JDK 17+, so
          the same profile skips formatting for this module only — formatting is still
          enforced by the JDK 8/11 reactor validate flow.
        -->
        <profile>
            <id>jdk17-boot-jar</id>
            <activation>
                <jdk>[17,)</jdk>
            </activation>
            <properties>
                <spotless.check.skip>true</spotless.check.skip>
                <spotless.apply.skip>true</spotless.apply.skip>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-maven-plugin</artifactId>
                        <version>${spring-boot.version}</version>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>repackage</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!--
          Docker/real-MySQL integration: clears the property-driven surefire exclusion so the
          docker-mysql tagged Testcontainers tests run. The suite shares one MySQL 5.7 container,
          while every test class owns a separate database obtained through Testcontainers'
          randomized endpoint; no fixed host database is contacted or cleaned.
        -->
        <profile>
            <id>docker-it</id>
            <properties>
                <docker-mysql.excluded></docker-mysql.excluded>
            </properties>
        </profile>
    </profiles>
</project>

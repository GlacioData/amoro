{
  "name": "dashboard-new",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "node --experimental-vm-modules ./scripts/dashboard-navigation.test.mjs && node ./scripts/preload-error-recovery.test.mjs && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test ./scripts/table-explorer-state.test.mts ./scripts/snapshot-page-state.test.mts ./scripts/snapshot-chart-data.test.mts ./scripts/file-statistics-view.test.mts ./scripts/table-model.test.mts ./scripts/tag-management-state.test.mts ./scripts/tag-snapshot-state.test.mts && vite build",
    "typecheck": "vue-tsc --noEmit",
    "gen:license": "node ./license.node.js",
    "preview": "vite preview",
    "test:preload-recovery": "node ./scripts/preload-error-recovery.test.mjs",
    "test:table-explorer": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test ./scripts/table-explorer-state.test.mts",
    "lint": "eslint ./src",
    "format": "eslint ./src --fix"
  },
  "dependencies": {
    "@ant-design/icons-vue": "7.0.1",
    "@vue/devtools-api": "^8.2.1",
    "ant-design-vue": "^4.2.6",
    "axios": "^1.20.0",
    "dayjs": "^1.11.23",
    "echarts": "^6.1.0",
    "pinia": "^4.1.0",
    "swagger-ui": "^5.33.2",
    "vue": "^3.5.44",
    "vue-clipboard3": "^2.0.0",
    "vue-i18n": "^11.4.14",
    "vue-router": "^5.4.0",
    "vue-virtual-scroller": "^3.0.5"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "eslint": "^10.12.0",
    "less": "4.9.1",
    "typescript": "~6.0.3",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.4",
    "vite-plugin-fake-server": "^2.2.4",
    "vite-plugin-svg-icons": "^2.0.1",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-tsc": "^3.3.13"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "packageManager": "pnpm@9.6.0",
  "pnpm": {
    "overrides": {
      "esbuild@0.27.7": "0.28.2"
    },
    "packageExtensions": {
      "vite-plugin-svg-icons@2.0.1": {
        "dependencies": {
          "fast-glob": "3.3.3"
        }
      }
    }
  }
}
